# ==============================================================================
# Sandesh Backend — Environment Variables
# For local dev (without Docker), copy to .env and fill in values.
# When using Docker Compose, the root .env is used instead.
# ==============================================================================

MONGODB_URI=mongodb://localhost:27017/phonemail
JWT_SECRET=change-me-in-production
MAIL_DOMAIN=sandesh.in
PORT=3001
SMTP_PORT=2525

# Telnyx SMS / Voice / IVR
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=

# Public Webhook URL (for Telnyx callbacks)
PUBLIC_WEBHOOK_BASE_URL=

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Logging
LOG_LEVEL=info
