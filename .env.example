# ==============================================================================
# Sandesh (PhoneMail) — Environment Variables
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==============================================================================

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Inside Docker Compose, this points to the internal 'mongo' service.
# For external MongoDB (e.g. Atlas), replace with your connection string.
MONGODB_URI=mongodb://mongo:27017/phonemail

# ── Authentication ────────────────────────────────────────────────────────────
# CHANGE THIS in production — used to sign JWT tokens
JWT_SECRET=change-me-in-production

# ── Email Domain ──────────────────────────────────────────────────────────────
MAIL_DOMAIN=sandesh.in

# ── Host Ports (left side of port mapping) ────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=5000
SMTP_PORT=2525

# ── Telnyx SMS / Voice / IVR Credentials ─────────────────────────────────────
# Sign up at https://telnyx.com and get credentials from your portal
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=

# ── Public Webhook URL ────────────────────────────────────────────────────────
# Required for Telnyx callbacks (SMS delivery, Voice IVR events)
# Use a tunnel (e.g. Tailscale Funnel, ngrok) to expose your local backend
PUBLIC_WEBHOOK_BASE_URL=

# ── Groq AI (FAQ Chatbot + Spam Detection + Email Assist) ────────────────────
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ── Logging ───────────────────────────────────────────────────────────────────
# Pino log levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
