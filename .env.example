# ==============================================================================
# PhoneMail Environment Variables (.env.example)
# Copy this file to .env before starting containers:
#   cp .env.example .env
# ==============================================================================

# MongoDB Connection
# When running inside Docker Compose, this points to the internal 'mongo' container.
MONGODB_URI=mongodb://mongo:27017/phonemail

# JWT Secret for Session & Authentication Tokens
JWT_SECRET=phonemail-super-secret-jwt-key-2026

# Email Domain
MAIL_DOMAIN=phonemail.com

# Host Ports
FRONTEND_PORT=3000
BACKEND_PORT=5000
SMTP_PORT=2525

# Twilio SMS / Voice Credentials (Optional - Mock/fallback used if empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# Textbee.dev Android SMS Gateway Credentials (Optional)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Groq API Configuration (for PhoneMail FAQ Chatbot)
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Pino Logger Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

